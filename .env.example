# 复制为 .env 后填写本机需要的值；真实密钥不要提交（.env 已被 gitignore）。
#
# 三种用法（系统环境优先，文件不会覆盖已存在的变量）：
#   1) 手工导出：      set -a; . ./.env; set +a
#   2) 显式加载：      jbt check-services --config configs/real-dev.example.yaml --env-file .env
#   3) 全局指定一次：  export JBT_ENV_FILE=/path/to/.env
#
# 本地 vLLM 未开认证时 LOCAL_API_KEY 可以留空，并把服务的 auth_required 设为 false。

INFERKNOCK_API_KEY=
LOCAL_API_KEY=
TARGET_API_KEY=
